<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MapEditorTool.Controls"
        mc:Ignorable="d" d:DesignWidth="1955" d:DesignHeight="1164"
        x:Class="MapEditorTool.MainWindow"
        Title="场景地图编辑器"
        Width="1955" Height="1164"
        MinWidth="1700" MinHeight="720"
        Background="{StaticResource Theme.Window}"
        FontSize="12">

  <Grid ColumnDefinitions="220,3,*">

    <!-- 左侧资源面板：整列收进一张分区卡里，和右侧各区块的描边形成层级 -->
    <Border Grid.Column="0" Classes="frame" Background="{StaticResource Theme.Panel}" Margin="5">
      <Grid RowDefinitions="237,Auto,*" Margin="4">

        <!-- 章节树卡：标题条（配置 / 删除）+ 章节 → 关卡列表，标题条改成白底细线，与各页页面头同款 -->
        <Border Grid.Row="0" Classes="card" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Border Background="{StaticResource Theme.Card}" BorderBrush="{StaticResource Theme.Divider}"
                    BorderThickness="0,0,0,1" Padding="6,3">
              <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" x:Name="BtnConfig" Content="配置" Classes="titleAction"
                        HorizontalAlignment="Stretch" Height="24" Margin="0,0,3,0"/>
                <Button Grid.Column="1" x:Name="BtnDelete" Content="删除" Classes="titleAction"
                        HorizontalAlignment="Stretch" Height="24" Margin="3,0,0,0"/>
              </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="*,14">
              <ScrollViewer Grid.Column="0" x:Name="ChapterScroll" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="ChapterList" Margin="4"/>
              </ScrollViewer>
              <controls:ClassicScrollBar Grid.Column="1" Target="{Binding #ChapterScroll}"/>
            </Grid>
          </Grid>
        </Border>

        <!-- 资源类型：白卡里的分段条，圆角与卡片一致 -->
        <Border Grid.Row="1" x:Name="ResourceTypeBar" Classes="card"
                Padding="2" Height="32" Margin="0,6,0,6" ClipToBounds="True">
          <Grid x:Name="ResourceTypeRow" ColumnDefinitions="*,*,*,Auto">
            <Button Grid.Column="0" x:Name="TabBuilding" Content="建筑" Classes="sideTab"
                    VerticalAlignment="Center"/>
            <Button Grid.Column="1" x:Name="TabGround" Content="人物" Classes="sideTab"
                    VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="TabProp" Content="物件" Classes="sideTab"
                    VerticalAlignment="Center"/>
            <Button Grid.Column="3" x:Name="BtnRefresh" Content="刷新" FontSize="12"
                    Width="42" Height="26" Padding="0" Margin="4,0,0,0"
                    VerticalAlignment="Center" HorizontalContentAlignment="Center"
                    Background="{StaticResource Theme.ButtonSurface}" BorderBrush="{StaticResource Theme.ButtonBorder}" BorderThickness="1"
                    CornerRadius="5" Foreground="{StaticResource Theme.Text}" ToolTip.Tip="刷新资源列表"/>
          </Grid>
        </Border>

        <Border Grid.Row="2" Classes="card" ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="{StaticResource Theme.Card}" BorderBrush="{StaticResource Theme.Divider}"
                    BorderThickness="0,0,0,1" Padding="8,4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="ResourceListTitle" Text="资源列表"
                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Theme.TitleText}"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{StaticResource Theme.PrimarySoft}" CornerRadius="8"
                        Padding="6,1" VerticalAlignment="Center">
                  <TextBlock x:Name="ResourceCountText" Text="0" FontSize="10"
                             FontWeight="SemiBold" Foreground="{StaticResource Theme.TitleText}"/>
                </Border>
              </Grid>
            </Border>
            <Grid Grid.Row="1" ColumnDefinitions="*,14">
              <ScrollViewer Grid.Column="0" x:Name="ResourceScroll" VerticalScrollBarVisibility="Hidden">
                <StackPanel x:Name="ResourceList" Margin="4"/>
              </ScrollViewer>
              <controls:ClassicScrollBar Grid.Column="1" Target="{Binding #ResourceScroll}"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="{StaticResource Theme.Border}"/>

    <!-- 右侧主区域 -->
    <Grid Grid.Column="2" Background="{StaticResource Theme.Window}" RowDefinitions="30,*">

      <!-- 顶部 Tab：加一条下边线，把页面切换条和下方工作区分开 -->
      <Border Grid.Row="0" Background="{StaticResource Theme.PanelAlt}" BorderBrush="{StaticResource Theme.Border}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*">
          <Button Grid.Column="0" x:Name="TabScene" Content="场景编辑" Classes="navTab" Width="92" Height="26" Margin="3,2"/>
          <Button Grid.Column="1" x:Name="TabItemElement" Content="物品元件编辑" Classes="navTab" Width="92" Height="26" Margin="3,2"/>
          <Button Grid.Column="2" x:Name="TabFog" Content="迷雾编辑" Classes="navTab" Width="92" Height="26" Margin="3,2"/>
          <Button Grid.Column="3" x:Name="TabResource" Content="资源整理" Classes="navTab" Width="92" Height="26" Margin="3,2"/>
          <Button Grid.Column="4" x:Name="TabStory" Content="剧情编辑" Classes="navTab" Width="92" Height="26" Margin="3,2"
                  ToolTip.Tip="剧情编辑：按节点写对白与分支，剧情文件跟着地图同名存成 .story.json"/>
        </Grid>
      </Border>

      <!-- 场景编辑面板 -->
      <Grid Grid.Row="1" x:Name="ScenePanel" RowDefinitions="Auto,*,Auto,Auto">

        <!-- 场景工具条 -->
        <Border Grid.Row="0" Classes="frame" Padding="6,5" Margin="4,4,4,0">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
              <Button x:Name="BtnExportSettings" Content="导出设置" Padding="10,4"/>
              <Button x:Name="BtnSave" Content="保存" Padding="10,4"/>
              <Button x:Name="BtnPublishTop" Content="发布" Padding="10,4" Background="{StaticResource Theme.Primary}" Foreground="White" BorderBrush="{StaticResource Theme.PrimaryDark}"/>
              <Button x:Name="BtnClearObjects" Content="清空摆放物" Padding="10,4" Background="Transparent" Foreground="{StaticResource Theme.DangerDark}" BorderBrush="#E0B4B1" BorderThickness="1"/>
              <Button x:Name="BtnClearGridData" Content="清空格子数据" Padding="10,4"/>
              <Button x:Name="BtnMapPreview" AutomationProperties.AutomationId="BtnMapPreview" Content="地图预览" Padding="10,4" Background="{StaticResource Theme.PrimarySoft}" Foreground="{StaticResource Theme.PrimaryDark}" BorderBrush="{StaticResource Theme.ButtonBorder}" BorderThickness="1"
                      ToolTip.Tip="打开只读地图预览窗：播放全图序列帧 / Spine 动画，任意带路径物件沿路径移动；不影响当前编辑数据"/>
              <Button x:Name="BtnImportPsd" Content="导入PSD" Padding="10,4" Background="{StaticResource Theme.PrimarySoft}" Foreground="{StaticResource Theme.PrimaryDark}" BorderBrush="{StaticResource Theme.ButtonBorder}" BorderThickness="1"/>
              <Button x:Name="BtnAddCollectible" Content="添加收集" Padding="10,4" Background="{StaticResource Theme.PrimarySoft}" Foreground="{StaticResource Theme.PrimaryDark}" BorderBrush="{StaticResource Theme.ButtonBorder}" BorderThickness="1"
                      ToolTip.Tip="两步向导：选择目标数量与收集物素材；完成后在画布右侧打开可拖动的收集物面板"/>
              <!-- 交通规则和「添加收集」一样是画布浮窗入口，排在收集后面，跟同一类操作放在一起 -->
              <Button x:Name="TabTraffic" Content="交通规则" Classes="toolToggle" Padding="10,4"
                      ToolTip.Tip="打开画布上的交通规则浮窗：灯 / 横道 / 车与行人的通行参数；可拖动停靠到画布边缘"/>
            </StackPanel>

            <TextBlock Grid.Column="1" x:Name="SaveHint" Margin="14,0" VerticalAlignment="Center"
                       FontSize="11" Foreground="{StaticResource Theme.TextMuted}" TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="图层：" VerticalAlignment="Center" Foreground="{StaticResource Theme.Text}"/>
              <CheckBox x:Name="LayerPlaceGrid" Content="摆放网格层" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerPathGrid" Content="路径网格" FontSize="11"/>
              <CheckBox x:Name="LayerMap" Content="地图层" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerBackground" Content="背景" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerGreenery" Content="绿化" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerRoad" Content="道路" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerBuilding" Content="建筑" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerObject" Content="道具" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerCollectible" Content="收集物" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerCharacter" Content="角色" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerForeground" Content="前景" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerBubbles" Content="气泡" FontSize="11" IsChecked="True"/>
              <CheckBox x:Name="LayerBoundingBox" Content="包围盒" FontSize="11"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- 画布 + 可停靠的收集物面板：停靠时画布让位，浮窗仍可在画布内拖动 -->
        <Grid Grid.Row="1" Margin="4,4,4,0" ClipToBounds="True">
          <Border x:Name="MapCanvasHost" Background="{StaticResource Theme.Border}" BorderBrush="{StaticResource Theme.BorderStrong}"
                  BorderThickness="1" CornerRadius="3" ClipToBounds="True">
            <Grid>
              <controls:MapCanvas x:Name="Canvas"/>
              <!-- TODO: 无地图存档时显示图一风格占位层，MT / Map Tool 标识，不拦截画布交互 -->
              <controls:MapEmptyStateOverlay x:Name="EmptyMapOverlay" IsVisible="True"
                                             IsHitTestVisible="False"/>
            </Grid>
          </Border>

          <Canvas x:Name="CollectibleOverlay" Background="{x:Null}" ClipToBounds="True">
            <Border x:Name="CollectibleDockHint" IsVisible="False" Width="4"
                    Background="{StaticResource Theme.Primary}" Opacity="0.9" IsHitTestVisible="False"/>
            <Border x:Name="CollectiblePanelHost" IsVisible="False"
                    Width="360" Height="300"
                    Background="{StaticResource Theme.PanelAlt}" BorderBrush="{StaticResource Theme.BorderStrong}" BorderThickness="1"
                    CornerRadius="4" BoxShadow="0 8 24 0 #55000000">
              <Grid RowDefinitions="34,*">
                <Border Grid.Row="0" x:Name="CollectiblePanelTitleBar"
                        Background="{StaticResource Theme.Panel}" BorderBrush="{StaticResource Theme.Border}" BorderThickness="0,0,0,1"
                        Padding="8,0,4,0">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Border Grid.Column="0" Grid.ColumnSpan="2" x:Name="CollectiblePanelDragArea"
                            Background="Transparent" Cursor="SizeAll"/>
                    <TextBlock Grid.Column="0" Text="收集物设置" FontSize="12"
                               FontWeight="SemiBold" Foreground="{StaticResource Theme.Text}"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Grid.Column="1" x:Name="CollectiblePanelHint"
                               Text="拖到边缘可吸附" FontSize="9" Foreground="{StaticResource Theme.TextMuted}"
                               VerticalAlignment="Center" Margin="8,0,4,0"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                    <Button Grid.Column="2" x:Name="BtnCollectibleReset" Content="重设"
                            Classes="mini" FontSize="10" Height="22" Width="38" Padding="0"
                            Margin="0,0,2,0" VerticalAlignment="Center"
                            ToolTip.Tip="重新打开添加收集向导"/>
                    <Button Grid.Column="3" x:Name="BtnCollectibleDock" Content="吸附"
                            Classes="mini" FontSize="10" Height="22" Width="38" Padding="0"
                            Margin="0,0,2,0" VerticalAlignment="Center"
                            ToolTip.Tip="吸附到画布左 / 右边缘，画布自动让位"/>
                    <Button Grid.Column="4" x:Name="BtnCollectibleClose" Content="×"
                            Classes="mini" FontSize="13" Height="22" Width="24" Padding="0"
                            VerticalAlignment="Center" ToolTip.Tip="关闭收集物面板，不删除收集计划"/>
                  </Grid>
                </Border>

                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource Theme.Border}"
                        BorderThickness="0,1,0,0">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CollectiblePanelList" Margin="10,8,8,8"/>
                  </ScrollViewer>
                </Border>

                <!-- 停靠后出现在靠画布一侧，按住可调整面板宽度 -->
                <Border x:Name="CollectiblePanelResizeHandle" Grid.RowSpan="2"
                        Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="Transparent" Cursor="SizeWestEast" IsVisible="False"
                        ToolTip.Tip="拖动调整收集物面板宽度"/>
              </Grid>
            </Border>
          </Canvas>

          <!-- 交通规则悬浮窗：默认浮在画布右侧，标题栏可拖动；拖到画布左/右边缘或点「停靠」贴边。
               面板不占工作区，地图始终可见，规则改动即时反映到画布与地图预览。 -->
          <Canvas x:Name="TrafficRuleOverlay" Background="{x:Null}" ClipToBounds="True" IsVisible="False">
            <Border x:Name="TrafficRuleDockHint" IsVisible="False" Width="4"
                    Background="{StaticResource Theme.Primary}" Opacity="0.9" IsHitTestVisible="False"/>
            <Border x:Name="TrafficRulePanelHost" IsVisible="False"
                    Width="640" Height="600"
                    Background="#F2F9FC" BorderBrush="{StaticResource Theme.BorderStrong}"
                    BorderThickness="1" CornerRadius="8"
                    BoxShadow="0 14 36 0 #66000000">
              <Grid RowDefinitions="38,*">
                <Border Grid.Row="0" x:Name="TrafficRuleTitleBar"
                        Background="#E6F6FB"
                        BorderBrush="{StaticResource Theme.Border}" BorderThickness="0,0,0,1"
                        Padding="10,0,6,0">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Grid.Column="0" Grid.ColumnSpan="2" x:Name="TrafficRuleDragArea"
                            Background="Transparent" Cursor="SizeAll"/>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" IsHitTestVisible="False">
                      <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#F1736F"/>
                        <Ellipse Width="7" Height="7" Fill="#F3C75F"/>
                        <Ellipse Width="7" Height="7" Fill="#56C88A"/>
                      </StackPanel>
                      <TextBlock Text="交通规则"
                                 FontSize="13" FontWeight="SemiBold"
                                 Foreground="{StaticResource Theme.Text}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="TrafficRuleHint"
                               Text="拖标题栏移动 · 拖到左右边缘停靠"
                               FontSize="9.5" Foreground="{StaticResource Theme.TextMuted}"
                               VerticalAlignment="Center" Margin="10,0,4,0"
                               TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                    <Button Grid.Column="2" x:Name="BtnTrafficDock" Content="停靠"
                            Classes="mini" FontSize="10" Height="24" Width="42" Padding="0"
                            Margin="0,0,4,0" VerticalAlignment="Center"
                            ToolTip.Tip="在浮动 / 贴边停靠之间切换"/>
                    <Button Grid.Column="3" x:Name="BtnTrafficClose" Content="×"
                            Classes="mini" FontSize="13" Height="24" Width="26" Padding="0"
                            VerticalAlignment="Center" ToolTip.Tip="关闭交通规则面板，规则数据保留"/>
                  </Grid>
                </Border>

                <Border Grid.Row="1" x:Name="TrafficRuleContent"
                        Background="#F2F9FC"
                        CornerRadius="0,0,8,8"
                        BorderBrush="{StaticResource Theme.Border}" BorderThickness="0"/>

                <!-- 停靠后出现在靠画布一侧，按住可调整面板宽度 -->
                <Border x:Name="TrafficRuleResizeHandle" Grid.RowSpan="2"
                        Width="10" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="Transparent" Cursor="SizeWestEast" IsVisible="False"
                        ZIndex="10"
                        ToolTip.Tip="拖动调整交通规则面板宽度"/>
              </Grid>
            </Border>
          </Canvas>
        </Grid>

        <!-- 状态栏：所有文本块统一 VerticalAlignment=Center，整条内容在栏内上下居中 -->
        <Border Grid.Row="2" Background="{StaticResource Theme.Status}" BorderBrush="{StaticResource Theme.StatusBorder}" BorderThickness="1" Padding="8,4">
          <Grid ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="缩放率:" Foreground="#CFE8F5" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusZoom" Text="100%" Foreground="#FFFFFF" Width="52" Margin="4,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="mouseX:" Foreground="#CFE8F5" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusMouseX" Text="0" Foreground="#FFFFFF" Width="52" Margin="4,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="mouseY:" Foreground="#CFE8F5" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusMouseY" Text="0" Foreground="#FFFFFF" Width="52" Margin="4,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="tileX:" Foreground="#CFE8F5" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusTileX" Text="0" Foreground="#FFFFFF" Width="44" Margin="4,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="tileY:" Foreground="#CFE8F5" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusTileY" Text="0" Foreground="#FFFFFF" Width="44" Margin="4,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="格子数:" Foreground="#CFE8F5" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusTileCount" Text="0" Foreground="#FFFFFF" Width="52" Margin="4,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="网格:" Foreground="#CFE8F5" Margin="16,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusGridSize" Text="128×128" Foreground="#FFFFFF" Width="64" Margin="4,0,0,0"
                       VerticalAlignment="Center"/>
            <TextBlock Text="保存路径:" Foreground="#CFE8F5" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusSavePath" Text="output/MapDatas/" Foreground="#FFFFFF" Width="266" Margin="4,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="BtnPickSaveDir" Content="…" Width="24" Padding="0" Height="20" Background="{StaticResource Theme.ButtonSurface}"
                    Margin="4,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
            </StackPanel>
            <!-- 操作结果放这里：横跨状态栏剩余宽度，不再被左侧那行一百多像素的 SceneHint 截断 -->
            <TextBlock Grid.Column="1" x:Name="OpHint" Text="" Foreground="#E8F4FA" FontSize="11"
                       Margin="18,0,4,0" VerticalAlignment="Center" TextAlignment="Right"
                       TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>

        <!-- 底部属性区：三张等高卡片，中间 6px 列放 GridSplitter。
             左 / 右列默认 420 / 900，拖分隔条可改左-中、右-中宽度；
             三列都带 Min/Max，拖到底也不会把卡片压没，窗口变宽时中间列继续吃余量。 -->
        <Grid Grid.Row="3" Margin="6,4,6,6" Height="356">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" MinWidth="320" MaxWidth="640"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="360"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="900" MinWidth="720" MaxWidth="1200"/>
          </Grid.ColumnDefinitions>

          <!-- 场景属性 -->
          <Border Grid.Column="0" Classes="card" Padding="10,9"
                  AutomationProperties.AutomationId="BottomCardScene">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="6">
              <Border Grid.Row="0" Classes="titleBar" Margin="-10,-9,-10,0">
                <TextBlock Text="场景属性" Classes="cardTitle"/>
              </Border>

              <!-- 地图动作：四颗同宽按钮，动作入口先于字段出现 -->
              <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <Button Grid.Column="0" x:Name="BtnUpdateMap" AutomationProperties.AutomationId="BtnUpdateMap" Content="更新地图" Classes="mini"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="PSD 源文件长度/修改时间变了：重读 PSD 并重建摆放物（会先确认）；未变化时退回从磁盘 JSON 重载。重载后保持当前缩放/平移"/>
                <Button Grid.Column="1" x:Name="BtnExportSlice" AutomationProperties.AutomationId="BtnExportSlice" Content="导出切片" Classes="mini"
                        HorizontalAlignment="Stretch"/>
                <Button Grid.Column="2" x:Name="BtnPreviewMap" AutomationProperties.AutomationId="BtnPreviewMap" Content="刷新画面" Classes="mini"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="重绘并自动修遮挡：按三带遮挡 + 脚底 Y 出图，背景组立体美术提层、池塘/地毯接缝贴合；核对贴图能否解析，PSD 改过会提示先点「更新地图」"/>
                <Button Grid.Column="3" x:Name="BtnRefreshLayer" AutomationProperties.AutomationId="BtnRefreshLayer" Content="刷新层级" Classes="mini"
                        HorizontalAlignment="Stretch"
                        ToolTip.Tip="综合刷新：重新分析三带遮挡（背景组立体美术提层、平面件窄缝贴合、像素尺寸补全），再按画面重排立体带层号并刷新显示；不改手动摆好的坐标与美术"/>
              </Grid>

              <!-- 场景名 / 场景ID -->
              <Grid Grid.Row="2" ColumnDefinitions="46,*,8,46,86" ColumnSpacing="4">
                <TextBlock Grid.Column="0" Text="场景名" Classes="lbl"/>
                <TextBox Grid.Column="1" x:Name="SceneNameField" Text="ChapterN" Classes="field" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="场景ID" Classes="lbl"/>
                <TextBox Grid.Column="4" x:Name="SceneIdField" Text="1" Classes="field" VerticalAlignment="Center"/>
              </Grid>

              <!-- 宽 / 高：两个字段均分剩余宽度，右侧不再留空 -->
              <Grid Grid.Row="3" ColumnDefinitions="46,*,8,46,*" ColumnSpacing="4">
                <TextBlock Grid.Column="0" Text="宽" Classes="lbl"/>
                <TextBox Grid.Column="1" x:Name="MapWidthField" Text="4096" Classes="field" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="高" Classes="lbl"/>
                <TextBox Grid.Column="4" x:Name="MapHeightField" Text="4096" Classes="field" VerticalAlignment="Center"/>
              </Grid>

              <!-- 操作结果单独一行，不再和按钮抢同一格宽度 -->
              <TextBlock Grid.Row="4" x:Name="SceneHint" Text="—" Classes="tip" TextTrimming="CharacterEllipsis"
                         Margin="1,0,0,0"/>

              <StackPanel Grid.Row="5" Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1,0,2">
                  <Border Width="3" Height="11" CornerRadius="2" Background="{StaticResource Theme.Primary}" VerticalAlignment="Center"/>
                  <TextBlock Text="绘制" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Theme.PrimaryDark}" VerticalAlignment="Center"/>
                  <TextBlock Text="摆放模式与区域开关" Classes="tip" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid ColumnDefinitions="84,*" ColumnSpacing="6">
                  <CheckBox Grid.Column="0" x:Name="PlacementToggle" Content="摆放模式" FontSize="11" IsChecked="True"/>
                  <ComboBox Grid.Column="1" x:Name="DrawShapeField" SelectedIndex="0" Classes="field" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="矩形绘制模式"/>
                    <ComboBoxItem Content="菱形绘制模式"/>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="84,*" ColumnSpacing="6">
                  <CheckBox Grid.Column="0" x:Name="DrawClearToggle" Content="DrawClear" FontSize="11" IsChecked="True"/>
                  <ComboBox Grid.Column="1" x:Name="RegionTypeField" SelectedIndex="0" Classes="field" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="摆放区"/>
                    <ComboBoxItem Content="禁区"/>
                    <ComboBoxItem Content="通用区"/>
                  </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="84,*" ColumnSpacing="6">
                  <CheckBox Grid.Column="0" x:Name="DrawBorderToggle" Content="DrawBorder" FontSize="11" IsChecked="True"/>
                  <TextBlock Grid.Column="1" Text="图片外框 + 占格描边" Classes="tip" VerticalAlignment="Center"/>
                </Grid>
                <Grid ColumnDefinitions="84,*" ColumnSpacing="6">
                  <CheckBox Grid.Column="0" x:Name="ClipOutsideMapToggle" Content="裁剪越界" FontSize="11" IsChecked="True"
                            ToolTip.Tip="勾选=按地图包围盒裁掉越界美术（推荐）；取消=完整显示越界图片，便于检查边缘出血与选中框"/>
                  <TextBlock Grid.Column="1" Text="地图包围盒外图片" Classes="tip" VerticalAlignment="Center"/>
                </Grid>
              </StackPanel>

              <Border Grid.Row="7" Classes="inset" Padding="9,7" VerticalAlignment="Bottom"
                      Background="{StaticResource Theme.PanelAlt}" CornerRadius="6"
                      ToolTip.Tip="Ctrl：按住=绘制矩形区域，松开=绘制菱形区域；Alt：按住=擦除格子；Shift：按住=曲线绘制；滚轮=缩放；右键拖动 / 中键 / 空格+左键=平移画布；Ctrl+Z=撤销拖动，Ctrl+Y=重做（焦点在输入框时撤销文字）">
                <StackPanel Spacing="3" TextOptions.TextRenderingMode="Antialias">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="3" Height="11" CornerRadius="2" Background="{StaticResource Theme.BorderStrong}" VerticalAlignment="Center"/>
                    <TextBlock Text="Ctrl 矩形 · 松开菱形 · Alt 擦除 · Shift 曲线" Classes="tip" FontSize="9.5" LineHeight="14"/>
                  </StackPanel>
                  <TextBlock Text="滚轮 缩放 · 右键/中键 平移 · Ctrl+Z 撤销 · Ctrl+Y 重做" Classes="tip" FontSize="9.5" LineHeight="14" Margin="9,0,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- 左右两处分隔条：1px 灰线打底，GridSplitter 透明盖在上面，悬停变淡蓝 -->
          <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{StaticResource Theme.Border}"/>
          <GridSplitter Grid.Column="1" x:Name="BottomSplitLeft" ZIndex="1"
                        AutomationProperties.AutomationId="BottomSplitLeft"
                        ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                        Cursor="SizeWestEast" BorderThickness="0"
                        ToolTip.Tip="拖动调整「场景属性」和「对象编辑」的宽度"/>

          <!-- 对象编辑 -->
          <Border Grid.Column="2" Classes="card" Padding="10,9"
                  AutomationProperties.AutomationId="BottomCardObject">
            <Grid RowDefinitions="Auto,Auto,Auto,*">

              <Border Grid.Row="0" Classes="titleBar" Margin="-10,-9,-10,7">
                <TextBlock x:Name="ObjEditTitle" Text="对象编辑：未选择" Classes="cardTitle"/>
              </Border>

              <!-- 分段页签 + 取消选中；下面一排是路径绘制动作 -->
              <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,10,120">
                  <Border Grid.Column="0" Background="{StaticResource Theme.PanelAlt}"
                          BorderBrush="{StaticResource Theme.Divider}" BorderThickness="1"
                          CornerRadius="8" Padding="3">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="2">
                      <Button Grid.Column="0" x:Name="TabEditPath" Content="路径信息" Classes="mini segTab"/>
                      <Button Grid.Column="1" x:Name="TabEditAnim" Content="动画信息" Classes="mini segTab"/>
                    </Grid>
                  </Border>
                  <!-- 取消选中是「反向操作」：白底红字描边，别用实心红和主按钮抢视觉 -->
                  <Button Grid.Column="2" x:Name="BtnClearTarget" Content="取消选中" Classes="mini" HorizontalAlignment="Stretch"
                          Background="Transparent" Foreground="{StaticResource Theme.DangerDark}" BorderBrush="#E0B4B1" BorderThickness="1"/>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                  <Button Grid.Column="0" x:Name="BtnPathDraw" Content="开始绘制路径" Classes="mini" HorizontalAlignment="Stretch" IsEnabled="False"/>
                  <Button Grid.Column="1" x:Name="BtnPathUndo" Content="撤销最后点" Classes="mini" HorizontalAlignment="Stretch" IsEnabled="False"/>
                  <Button Grid.Column="2" x:Name="BtnPathClear" Content="清空路径" Classes="mini" HorizontalAlignment="Stretch" IsEnabled="False"/>
                </Grid>
              </StackPanel>

              <TextBlock Grid.Row="2" Text="「开始绘制路径」后：左键点地面加点，Ctrl+右键撤点" Classes="tip" FontSize="9.5" Margin="1,0,0,6"
                         ToolTip.Tip="点到其他物件会忽略，不会切换选中；吸附 32px 网格；动画页签下拉动进度条可实时预览移动"/>

              <Border Grid.Row="3" Background="{StaticResource Theme.PanelAlt}"
                      BorderBrush="{StaticResource Theme.Divider}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                <Grid>
                  <ScrollViewer x:Name="PathScroll">
                    <StackPanel x:Name="PathPointList" Spacing="2"/>
                  </ScrollViewer>

                  <!-- 路径为空时的居中空态，避免整片空白框只剩一行贴顶小字 -->
                  <TextBlock x:Name="PathEmptyHint" IsVisible="False"
                             Text="暂无路径点" FontSize="11" Foreground="{StaticResource Theme.TextMuted}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                             MaxWidth="320" TextWrapping="Wrap"/>

                  <Grid x:Name="AnimPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                    <Grid Grid.Row="0" ColumnDefinitions="64,*,10,36,66">
                      <TextBlock Grid.Column="0" Text="动画名称" Classes="lbl"/>
                      <ComboBox Grid.Column="1" x:Name="AnimNameField" Classes="field" IsEditable="True" HorizontalAlignment="Stretch"
                                PlaceholderText="输入或选择已导入动画"/>
                      <TextBlock Grid.Column="3" Text="速度" Classes="lbl"/>
                      <TextBox Grid.Column="4" x:Name="AnimSpeedField" Classes="field"/>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="64,*,Auto">
                      <TextBlock Grid.Column="0" Text="动画来源" Classes="lbl"/>
                      <ComboBox Grid.Column="1" x:Name="AnimKindField" Classes="field" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="序列帧"/>
                        <ComboBoxItem Content="Spine"/>
                      </ComboBox>
                      <CheckBox Grid.Column="2" x:Name="AnimEnabledToggle" Content="启用" FontSize="11" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="64,*,10,42,110">
                      <TextBlock Grid.Column="0" Text="Spine资产" Classes="lbl"/>
                      <ComboBox Grid.Column="1" x:Name="SpineAssetField" Classes="field" PlaceholderText="未导入" HorizontalAlignment="Stretch"/>
                      <TextBlock Grid.Column="3" Text="待机" Classes="lbl"/>
                      <ComboBox Grid.Column="4" x:Name="SpineAnimationField" Classes="field" PlaceholderText="骨架内待机动画"/>
                    </Grid>

                    <Grid Grid.Row="3" ColumnDefinitions="64,*,10,42,110">
                      <TextBlock Grid.Column="0" Text="行走动画" Classes="lbl" ToolTip.Tip="角色沿路径移动时自动切换到该动作；骨架内含 walk_up / walk_down_right 等方向动作时按八方向自动切换，没有方向动作时回落到该动作并按左右方向镜像"/>
                      <ComboBox Grid.Column="1" Grid.ColumnSpan="4" x:Name="SpineWalkAnimationField" Classes="field" PlaceholderText="骨架内行走动画"/>
                    </Grid>

                    <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                      <CheckBox Grid.Column="0" x:Name="AnimLoopToggle" Content="循环" FontSize="11" IsChecked="True"/>
                      <Button Grid.Column="1" x:Name="BtnImportFrames" Content="导入序列帧" Classes="mini" Margin="6,0,0,0"/>
                      <Button Grid.Column="3" x:Name="BtnImportSpine" Content="导入Spine" Classes="mini" Margin="0,0,4,0"/>
                      <Button Grid.Column="4" x:Name="BtnPreviewAnim" Content="预览动画" Classes="mini"/>
                    </Grid>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Border Grid.Column="3" Width="1" HorizontalAlignment="Center" Background="{StaticResource Theme.Border}"/>
          <GridSplitter Grid.Column="3" x:Name="BottomSplitRight" ZIndex="1"
                        AutomationProperties.AutomationId="BottomSplitRight"
                        ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                        Cursor="SizeWestEast" BorderThickness="0"
                        ToolTip.Tip="拖动调整「对象编辑」和「属性 + 物体编辑」的宽度"/>

          <!-- 属性详情 -->
          <!-- TODO [属性卡分组] 这张卡仍是一条长表单，后续可在「遮挡带 / 图层 / 交互」前加小节标题（基础 / 遮挡与层级 / 交互），
               把 10 个字段切成三组；需要改动 Grid 行号，单独一轮再做。 -->
          <Border Grid.Column="4" Classes="card" Padding="10,9"
                  AutomationProperties.AutomationId="BottomCardProperty">
            <Grid RowDefinitions="Auto,*,Auto">

              <Border Grid.Row="0" Classes="titleBar" Margin="-10,-9,-10,7">
                <TextBlock Text="属性" Classes="cardTitle"/>
              </Border>

              <Grid Grid.Row="1" ColumnDefinitions="*,1,280" ColumnSpacing="10">

                <!-- 左：静态属性字段；右侧滚动条与「物体编辑」同款 ClassicScrollBar，不再用默认细条 -->
                <Grid Grid.Column="0" ColumnDefinitions="*,8,14">
                  <ScrollViewer Grid.Column="0" x:Name="PropertyScroll"
                                VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="PropertyBody" Spacing="3">

                    <!-- 统一五列栅格：标签列 / 左字段 / 间隔 / 短标签列 / 右字段。
                         前三行左右两组字段等宽，所有输入框共用同一条左边缘、中线与右边缘：
                         ID|Tag、X|Y、宽|高 的外框一一对称，X/Y/宽/高 小标签改为字段内前缀，不再把输入框顶偏。 -->
                    <Grid ColumnDefinitions="56,*,12,44,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="6" HorizontalAlignment="Stretch">

                      <TextBlock Grid.Row="0" Grid.Column="0" Text="ID" Classes="lbl"
                                 ToolTip.Tip="物件自己的 8 位数字 ID，全图唯一，可对外引用；右侧是配置表数字 ID"/>
                      <Grid Grid.Row="0" Grid.Column="1">
                        <TextBox x:Name="PropTemplateId" Classes="field" HorizontalAlignment="Stretch" Padding="6,0,74,0"
                                 IsReadOnly="True" Background="{StaticResource Theme.PanelAlt}" Foreground="{StaticResource Theme.Text}" FontFamily="Consolas"
                                 ToolTip.Tip="8 位数字物件 ID：每个物件独有，导出与剧情都按它引用"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                          <Border x:Name="PropSceneIndexBadge" Background="{StaticResource Theme.PanelAlt}" BorderBrush="{StaticResource Theme.Border}" IsHitTestVisible="False"
                                  BorderThickness="1" CornerRadius="2" Padding="4,1">
                            <TextBlock x:Name="PropSceneIndexText" Text="" FontSize="8" Foreground="{StaticResource Theme.TextMuted}"/>
                          </Border>
                          <Border x:Name="PropIdSourceBadge" Background="{StaticResource Theme.PrimarySoft}" BorderBrush="{StaticResource Theme.Border}" IsHitTestVisible="False"
                                  BorderThickness="1" CornerRadius="2" Padding="4,1">
                            <TextBlock x:Name="PropIdSourceText" Text="配置" FontSize="8" Foreground="{StaticResource Theme.PrimaryDark}"/>
                          </Border>
                        </StackPanel>
                      </Grid>
                      <TextBlock Grid.Row="0" Grid.Column="3" Text="Tag" Classes="lbl"
                                 ToolTip.Tip="分层标识键：building / prop / road …"/>
                      <Grid Grid.Row="0" Grid.Column="4">
                        <TextBox x:Name="PropTag" Classes="field" HorizontalAlignment="Stretch" Padding="16,0,6,0"
                                 IsReadOnly="True" Background="{StaticResource Theme.PanelAlt}" Foreground="{StaticResource Theme.Text}"
                                 ToolTip.Tip="分层标识键；颜色与图层一一对应"/>
                        <Border x:Name="PropLayerTagDot" Width="6" Height="18" IsHitTestVisible="False"
                                CornerRadius="2" Background="#E8A23F" Margin="6,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                      </Grid>

                      <TextBlock Grid.Row="1" Grid.Column="0" Text="格子坐标" Classes="lbl"/>
                      <Grid Grid.Row="1" Grid.Column="1">
                        <TextBox x:Name="PropCellX" Classes="field" HorizontalAlignment="Stretch" Padding="18,0,6,0" FontFamily="Consolas"
                                 ToolTip.Tip="格子坐标 X（可编辑，按 32px 一格换算世界坐标）"/>
                        <TextBlock Text="X" Classes="tip" FontSize="10" Margin="6,0,0,0" Padding="0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                      </Grid>
                      <Grid Grid.Row="1" Grid.Column="4">
                        <TextBox x:Name="PropCellY" Classes="field" HorizontalAlignment="Stretch" Padding="18,0,6,0" FontFamily="Consolas"
                                 ToolTip.Tip="格子坐标 Y（可编辑，按 32px 一格换算世界坐标）"/>
                        <TextBlock Text="Y" Classes="tip" FontSize="10" Margin="6,0,0,0" Padding="0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                      </Grid>

                      <TextBlock Grid.Row="2" Grid.Column="0" Text="格子数" Classes="lbl"/>
                      <Grid Grid.Row="2" Grid.Column="1">
                        <TextBox x:Name="PropCellW" Classes="field" HorizontalAlignment="Stretch" Padding="18,0,6,0"
                                 IsReadOnly="True" Background="{StaticResource Theme.PanelAlt}" Foreground="{StaticResource Theme.Text}" FontFamily="Consolas"
                                 ToolTip.Tip="物件占格宽（只读，由 PSD 像素宽 / 32 换算）"/>
                        <TextBlock Text="宽" Classes="tip" FontSize="10" Margin="6,0,0,0" Padding="0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                      </Grid>
                      <Grid Grid.Row="2" Grid.Column="4">
                        <TextBox x:Name="PropCellH" Classes="field" HorizontalAlignment="Stretch" Padding="18,0,6,0"
                                 IsReadOnly="True" Background="{StaticResource Theme.PanelAlt}" Foreground="{StaticResource Theme.Text}" FontFamily="Consolas"
                                 ToolTip.Tip="物件占格高（只读，由 PSD 像素高 / 32 换算）"/>
                        <TextBlock Text="高" Classes="tip" FontSize="10" Margin="6,0,0,0" Padding="0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                      </Grid>

                      <TextBlock Grid.Row="3" Grid.Column="0" Text="层级" Classes="lbl"/>
                      <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" ColumnDefinitions="120,24,*" ColumnSpacing="0">
                        <TextBox Grid.Column="0" x:Name="PropSortOrder" Classes="field" HorizontalAlignment="Stretch" FontFamily="Consolas"
                                 BorderThickness="1,1,0,1" CornerRadius="3,0,0,3"
                                 ToolTip.Tip="Unity 全局 sortOrder（0–79）：十位是层、个位是层内档位"/>
                        <!-- TODO 视觉统一：层级步进器改成与输入框贴合的上下箭头，替代原先分散在行尾的减号 / 加号按钮。 -->
                        <Border Grid.Column="1" Width="24" Height="24"
                                Background="{StaticResource Theme.Card}"
                                BorderBrush="{StaticResource Theme.ButtonBorder}"
                                BorderThickness="0,1,1,1" CornerRadius="0,3,3,0"
                                ClipToBounds="True">
                          <Grid RowDefinitions="*,*">
                            <Button Grid.Row="0" x:Name="BtnLayerPlus" AutomationProperties.AutomationId="BtnLayerPlus"
                                    Content="▲" Classes="spin"
                                    ToolTip.Tip="层级 +1（最高 79）"/>
                            <Button Grid.Row="1" x:Name="BtnLayerMinus" AutomationProperties.AutomationId="BtnLayerMinus"
                                    Content="▼" Classes="spin"
                                    ToolTip.Tip="层级 −1（最低 0）"/>
                          </Grid>
                        </Border>
                      </Grid>

                      <!-- 遮挡带：选中贴图的层级信息，改这里就把这张图换到另一层 -->
                      <TextBlock Grid.Row="4" Grid.Column="0" Text="遮挡带" Classes="lbl"/>
                      <ComboBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" x:Name="PropBand" Classes="field"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="自动 = 按图层类型 / 名字判定；地表在最底、立体跨图层按脚底 Y、叠加永远最上">
                        <ComboBoxItem Content="自动（按图层判定）"/>
                        <ComboBoxItem Content="地表（最底层）"/>
                        <ComboBoxItem Content="立体（按脚底 Y）"/>
                        <ComboBoxItem Content="叠加（永远最上）"/>
                      </ComboBox>

                      <Border Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" x:Name="PropBandInfoBox"
                              IsVisible="False" Background="{StaticResource Theme.PanelAlt}"
                              BorderBrush="{StaticResource Theme.Divider}" BorderThickness="1"
                              CornerRadius="6" Padding="8,6">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7"
                              TextOptions.TextRenderingMode="Antialias">
                          <Border Grid.Column="0" Width="3" CornerRadius="2" Background="{StaticResource Theme.Cyan}" VerticalAlignment="Stretch"/>
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock x:Name="PropBandInfo" FontSize="10" FontWeight="Normal" LineHeight="14"
                                       Foreground="{StaticResource Theme.Text}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PropBandOrderInfo" FontSize="10" LineHeight="14"
                                       Foreground="{StaticResource Theme.TextMuted}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PropBandLayerInfo" FontSize="10" LineHeight="14"
                                       Foreground="{StaticResource Theme.TextMuted}" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Grid>
                      </Border>

                      <TextBlock Grid.Row="6" Grid.Column="0" Text="图层" Classes="lbl"/>
                      <ComboBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" x:Name="PropDisplayLayer"
                                Classes="field" HorizontalAlignment="Stretch"/>

                      <TextBlock Grid.Row="7" Grid.Column="0" Text="交互" Classes="lbl"/>
                      <ComboBox Grid.Row="7" Grid.Column="1" x:Name="PropInteractType" Classes="field"
                                HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="无"/>
                        <ComboBoxItem Content="点击"/>
                        <ComboBoxItem Content="对话"/>
                        <ComboBoxItem Content="进入"/>
                        <ComboBoxItem Content="收集"/>
                      </ComboBox>
                      <TextBlock Grid.Row="7" Grid.Column="3" Text="朝向" Classes="lbl"/>
                      <ComboBox Grid.Row="7" Grid.Column="4" x:Name="PropFacing" Classes="field"
                                HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="上"/>
                        <ComboBoxItem Content="下"/>
                        <ComboBoxItem Content="左"/>
                        <ComboBoxItem Content="右"/>
                      </ComboBox>

                      <StackPanel Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="4" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <CheckBox x:Name="PropCollision" Content="碰撞" FontSize="10" VerticalAlignment="Center"/>
                          <CheckBox x:Name="PropShadow" Content="阴影" FontSize="10" VerticalAlignment="Center"/>
                          <CheckBox x:Name="PropCollectible" Content="收集" FontSize="10" VerticalAlignment="Center"/>
                          <CheckBox x:Name="PropShowObjectEdit" Content="编辑" FontSize="10" VerticalAlignment="Center" IsChecked="True"
                                    ToolTip.Tip="勾选显示右侧「物体编辑」分组（旋转 / 大小 / 是否缩放）"/>
                        </StackPanel>
                      </StackPanel>

                      <TextBlock Grid.Row="9" Grid.Column="0" Text="气泡" Classes="lbl"/>
                      <TextBox Grid.Row="9" Grid.Column="1" x:Name="PropDialogBubble" Classes="field" HorizontalAlignment="Stretch"/>
                      <TextBlock Grid.Row="9" Grid.Column="3" Text="气泡ID" Classes="lbl" FontSize="10"/>
                      <TextBox Grid.Row="9" Grid.Column="4" x:Name="PropBubble" Classes="field" HorizontalAlignment="Stretch"/>

                      <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="5" x:Name="PropSummary"
                                 Text="未选中物体。" Classes="tip" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </Grid>
                  </StackPanel>
                  </ScrollViewer>
                  <controls:ClassicScrollBar Grid.Column="2" Target="{Binding #PropertyScroll}"/>
                </Grid>

                <!-- 竖分隔线 -->
                <Border Grid.Column="1" Background="{StaticResource Theme.Divider}" Width="1" Margin="0,2"/>

                <!-- 右：交通规则列；内容超出高度时可上下滚动（自写箭头滚动条，与左侧列表同款） -->
                <Border Grid.Column="2" x:Name="TrafficPanel" Classes="inset" Background="{StaticResource Theme.Card}" Padding="0">
                  <Grid ColumnDefinitions="*,14">

                    <ScrollViewer Grid.Column="0" x:Name="TrafficScroll" Padding="10,8,5,8"
                                  VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="7">

                    <!-- 物体编辑：由属性面板「编辑」勾选框控制整块显隐，未选中实例时内部置灰 -->
                    <StackPanel x:Name="ObjectEditSection" Spacing="7">
                      <Border Height="1" Background="{StaticResource Theme.Divider}" Margin="0,2"/>

                      <TextBlock Text="物体编辑" Classes="section" FontSize="11"/>
                      <StackPanel x:Name="ObjectEditGroup" Spacing="7">
                      <!-- 位置：世界坐标像素（相对地图左上角），与数据字段 x / y 一致，回车或失焦提交；
                           「X / Y」标签按住左键左右拖动可直接加减（Unity 式 scrub） -->
                      <Grid ColumnDefinitions="74,Auto,*,Auto,*" ColumnSpacing="3">
                        <TextBlock Grid.Column="0" Text="位置(px)" Classes="lbl"/>
                        <TextBlock Grid.Column="1" x:Name="PropPosXLabel" Text="X" FontSize="10" Foreground="{StaticResource Theme.TextMuted}"
                                   VerticalAlignment="Center" Cursor="SizeWestEast" Background="Transparent"
                                   ToolTip.Tip="按住左键左右拖动：连续调整世界坐标 X（1px = 1 像素，Shift ×10）"/>
                        <TextBox Grid.Column="2" x:Name="PropPosX" Text="0" Classes="field"
                                 ToolTip.Tip="世界坐标 X（像素，相对地图左上角），回车或失焦提交；按住左键左右拖动也可连续调整"/>
                        <TextBlock Grid.Column="3" x:Name="PropPosYLabel" Text="Y" FontSize="10" Foreground="{StaticResource Theme.TextMuted}"
                                   VerticalAlignment="Center" Cursor="SizeWestEast" Background="Transparent"
                                   ToolTip.Tip="按住左键左右拖动：连续调整世界坐标 Y（1px = 1 像素，Shift ×10）"/>
                        <TextBox Grid.Column="4" x:Name="PropPosY" Text="0" Classes="field"
                                 ToolTip.Tip="世界坐标 Y（像素，相对地图左上角），回车或失焦提交；按住左键左右拖动也可连续调整"/>
                      </Grid>

                      <Grid ColumnDefinitions="74,Auto,*,Auto,Auto" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="旋转" Classes="lbl"/>
                        <Button Grid.Column="1" x:Name="BtnEditRotateLeft" Content="↺" Classes="mini" Width="24"
                                ToolTip.Tip="逆时针旋转 15°"/>
                        <TextBlock Grid.Column="2" x:Name="EditAngleText" Text="0°" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   ToolTip.Tip="当前角度（与数据字段 rotation 一致）"/>
                        <Button Grid.Column="3" x:Name="BtnEditRotateRight" Content="↻" Classes="mini" Width="24"
                                ToolTip.Tip="顺时针旋转 15°"/>
                        <Button Grid.Column="4" x:Name="BtnEditRotateReset" Content="重置" Classes="mini"
                                ToolTip.Tip="角度恢复到 0°"/>
                      </Grid>

                      <Grid ColumnDefinitions="74,*,Auto,*" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="大小(px)" Classes="lbl"/>
                        <TextBox Grid.Column="1" x:Name="PropSizeW" Text="0" Classes="field"
                                 ToolTip.Tip="显示尺寸宽度（像素），回车或失焦提交"/>
                        <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" Foreground="{StaticResource Theme.TextMuted}"/>
                        <TextBox Grid.Column="3" x:Name="PropSizeH" Text="0" Classes="field"
                                 ToolTip.Tip="显示尺寸高度（像素），回车或失焦提交"/>
                      </Grid>

                      <CheckBox x:Name="PropStretch" Content="是否缩放" FontSize="10"
                                ToolTip.Tip="勾选：贴图按「大小」缩放铺满；取消：贴图按素材原始像素居中绘制，大小只决定占格与选框"/>
                      </StackPanel>

                      <!-- 层序号数据（整图生效）：画面前后已按「遮挡带 + 脚底 Y」，这里只重写 Unity 用的 sortOrder -->
                      <Border Height="1" Background="{StaticResource Theme.Divider}" Margin="0,3,0,1"/>
                      <Grid ColumnDefinitions="74,*,*" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="遮挡" Classes="lbl"/>
                        <Button Grid.Column="1" x:Name="BtnResortPicture" Content="按画面重排" Classes="mini"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="把立体带的 sortOrder 按「脚底 Y」重写，供 Unity 侧数据对齐；画面前后本来就已经按脚底 Y 排，不会因此改变"/>
                        <Button Grid.Column="2" x:Name="BtnResortPsd" Content="还原层序" Classes="mini"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="把 sortOrder 恢复成 PSD 原始层序；画面前后仍按「遮挡带 + 脚底 Y」，不会回到旧遮挡"/>
                      </Grid>
                    </StackPanel>
                    <!-- 交通分组：启动时整体搬进「交通规则 → 物件标记」页（见 MainWindow.TrafficEvents.MoveTrafficControlsToRulePanel），
                         右栏只保留物件本身的编辑项。卡片与 markTool 样式在主页与面板里通用。 -->
                    <StackPanel x:Name="TrafficDrawGroup" Spacing="10">

                    <!-- ① 标记：选中地图物件后点按钮打 / 取消标记，快捷键写在标题右侧 -->
                    <Border Background="{StaticResource Theme.Card}" BorderBrush="{StaticResource Theme.Divider}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10,12,12">
                      <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="3" Height="12" CornerRadius="2" Background="{StaticResource Theme.Primary}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="交通标记" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Theme.PrimaryDark}" VerticalAlignment="Center"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="F1 · F2 · F3 · F4" Classes="tip" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Theme.Divider}"/>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                          <Button Grid.Row="0" Grid.Column="0" x:Name="BtnToolSidewalk" Content="标记人行道" Classes="markTool"
                                  ToolTip.Tip="把选中物件标记为人行道（F1）；再点一次即取消"/>
                          <Button Grid.Row="0" Grid.Column="1" x:Name="BtnToolRoad" Content="标记道路" Classes="markTool"
                                  ToolTip.Tip="把选中物件标记为道路（F2）；再点一次即取消"/>
                          <Button Grid.Row="1" Grid.Column="0" x:Name="BtnToolCrosswalk" Content="标记横道" Classes="markTool"
                                  ToolTip.Tip="把选中物件标记为横道（F3）；再点一次即取消"/>
                          <Button Grid.Row="1" Grid.Column="1" x:Name="BtnToolLight" Content="标记红绿灯" Classes="markTool"
                                  ToolTip.Tip="把选中物件标记为红绿灯（F4）；再点一次即取消"/>
                        </Grid>

                        <TextBlock Classes="tip" TextWrapping="Wrap"
                                   Text="同类型再点一次即取消；一个物件只保留一种交通标记，换标记会自动清掉旧的。"/>
                      </StackPanel>
                    </Border>

                    <!-- ② 实例属性：载具 / 角色 / 停止线 / 绑定灯，仅作用于当前选中物件 -->
                    <Border Background="{StaticResource Theme.Card}" BorderBrush="{StaticResource Theme.Divider}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10,12,12">
                      <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="3" Height="12" CornerRadius="2" Background="{StaticResource Theme.Teal}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="实例属性" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Theme.TealDark}" VerticalAlignment="Center"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="仅作用于当前选中物件" Classes="tip" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource Theme.Divider}"/>

                        <WrapPanel Orientation="Horizontal">
                          <CheckBox x:Name="PropTraffic" Content="可交互" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"
                                    IsChecked="True" ToolTip.Tip="写入 interactable：物件能否被玩家或剧情交互"/>
                          <CheckBox x:Name="PropVehicle" Content="是否载具" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
                          <CheckBox x:Name="PropYellowAsRed" Content="黄灯按红灯" FontSize="11" VerticalAlignment="Center" IsChecked="True"
                                    ToolTip.Tip="黄灯按红灯处理（仅车辆）"/>
                        </WrapPanel>

                        <Grid ColumnDefinitions="74,*" ColumnSpacing="8">
                          <TextBlock Grid.Column="0" Text="交通角色" Classes="lbl"/>
                          <ComboBox Grid.Column="1" x:Name="PropTrafficRole" Classes="field" HorizontalAlignment="Stretch"/>
                        </Grid>

                        <Grid ColumnDefinitions="74,*" ColumnSpacing="8">
                          <TextBlock Grid.Column="0" Text="停止线(X,Y)" Classes="lbl"/>
                          <TextBox Grid.Column="1" x:Name="PropStopLine" Text="0, 0" Classes="field"/>
                        </Grid>

                        <Grid ColumnDefinitions="74,*,Auto" ColumnSpacing="8">
                          <TextBlock Grid.Column="0" Text="绑定红绿灯" Classes="lbl"/>
                          <CheckBox Grid.Column="1" x:Name="PropLightSelectAll" Content="全选" FontSize="10" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="勾选即绑定" Classes="tip" VerticalAlignment="Center"/>
                        </Grid>

                        <Border BorderBrush="{StaticResource Theme.Divider}" BorderThickness="1"
                                Background="{StaticResource Theme.PanelAlt}" CornerRadius="6" MinHeight="40" MaxHeight="126">
                          <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PropLightList" Margin="8,6" Spacing="2"/>
                          </ScrollViewer>
                        </Border>
                      </StackPanel>
                    </Border>

                    </StackPanel>


                    <!-- 碰撞区域：属性勾选「碰撞」时显示；数值相对物体包围盒左上角，宽高 0 = 铺满 -->
                    <StackPanel x:Name="CollisionAreaSection" Spacing="7" IsVisible="False">
                      <Border Height="1" Background="{StaticResource Theme.Divider}" Margin="0,2"/>
                      <TextBlock Text="碰撞区域" Classes="section" FontSize="11"/>
                      <TextBlock Text="相对物体左上角（px），宽高 0 表示铺满" Classes="tip"/>

                      <Grid ColumnDefinitions="74,*,Auto,*" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="XY(px)" Classes="lbl"/>
                        <TextBox Grid.Column="1" x:Name="CollisionXField" Classes="field"
                                 ToolTip.Tip="相对包围盒左边的偏移（像素）"/>
                        <TextBlock Grid.Column="2" Text="," VerticalAlignment="Center" Foreground="{StaticResource Theme.TextMuted}"/>
                        <TextBox Grid.Column="3" x:Name="CollisionYField" Classes="field"
                                 ToolTip.Tip="相对包围盒上边的偏移（像素）"/>
                      </Grid>

                      <Grid ColumnDefinitions="74,*,Auto,*" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="宽高(px)" Classes="lbl"/>
                        <TextBox Grid.Column="1" x:Name="CollisionWField" Classes="field"
                                 ToolTip.Tip="碰撞区域宽，0 表示铺满包围盒"/>
                        <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" Foreground="{StaticResource Theme.TextMuted}"/>
                        <TextBox Grid.Column="3" x:Name="CollisionHField" Classes="field"
                                 ToolTip.Tip="碰撞区域高，0 表示铺满包围盒"/>
                      </Grid>

                      <Button x:Name="BtnCollisionReset" Content="重置为铺满" Classes="mini"
                              HorizontalAlignment="Stretch" ToolTip.Tip="碰撞区域恢复到整个包围盒"/>
                    </StackPanel>

                    <!-- 阴影区域：属性勾选「阴影」时显示 -->
                    <StackPanel x:Name="ShadowAreaSection" Spacing="7" IsVisible="False">
                      <Border Height="1" Background="{StaticResource Theme.Divider}" Margin="0,2"/>
                      <TextBlock Text="阴影区域" Classes="section" FontSize="11"/>
                      <TextBlock Text="相对物体左上角（px），宽高 0 表示铺满" Classes="tip"/>

                      <Grid ColumnDefinitions="74,*,Auto,*" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="XY(px)" Classes="lbl"/>
                        <TextBox Grid.Column="1" x:Name="ShadowXField" Classes="field"
                                 ToolTip.Tip="相对包围盒左边的偏移（像素）"/>
                        <TextBlock Grid.Column="2" Text="," VerticalAlignment="Center" Foreground="{StaticResource Theme.TextMuted}"/>
                        <TextBox Grid.Column="3" x:Name="ShadowYField" Classes="field"
                                 ToolTip.Tip="相对包围盒上边的偏移（像素）"/>
                      </Grid>

                      <Grid ColumnDefinitions="74,*,Auto,*" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="宽高(px)" Classes="lbl"/>
                        <TextBox Grid.Column="1" x:Name="ShadowWField" Classes="field"
                                 ToolTip.Tip="阴影区域宽，0 表示铺满包围盒"/>
                        <TextBlock Grid.Column="2" Text="×" VerticalAlignment="Center" Foreground="{StaticResource Theme.TextMuted}"/>
                        <TextBox Grid.Column="3" x:Name="ShadowHField" Classes="field"
                                 ToolTip.Tip="阴影区域高，0 表示铺满包围盒"/>
                      </Grid>

                      <Button x:Name="BtnShadowReset" Content="重置为铺满" Classes="mini"
                              HorizontalAlignment="Stretch" ToolTip.Tip="阴影区域恢复到整个包围盒"/>
                    </StackPanel>

                    <!-- 物体变换（仅勾选「收集」的实例）：层级 / 比例 / 角度，操作即时生效 -->
                    <StackPanel x:Name="TransformSection" Spacing="7" IsVisible="False">
                      <Border Height="1" Background="{StaticResource Theme.Divider}" Margin="0,2"/>
                      <TextBlock Text="物体变换" Classes="section" FontSize="11"/>

                      <Grid ColumnDefinitions="36,*,*,*,*" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="层级" Classes="lbl"/>
                        <Button Grid.Column="1" x:Name="BtnOrderUp" Content="上移" Classes="mini"
                                HorizontalAlignment="Stretch" ToolTip.Tip="同层内上移一个档位"/>
                        <Button Grid.Column="2" x:Name="BtnOrderDown" Content="下移" Classes="mini"
                                HorizontalAlignment="Stretch" ToolTip.Tip="同层内下移一个档位"/>
                        <Button Grid.Column="3" x:Name="BtnOrderTop" Content="置顶" Classes="mini"
                                HorizontalAlignment="Stretch" ToolTip.Tip="同层内排到最上层"/>
                        <Button Grid.Column="4" x:Name="BtnOrderBottom" Content="置底" Classes="mini"
                                HorizontalAlignment="Stretch" ToolTip.Tip="同层内排到最下层"/>
                      </Grid>

                      <Grid ColumnDefinitions="36,Auto,*,Auto,Auto" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="比例" Classes="lbl"/>
                        <Button Grid.Column="1" x:Name="BtnScaleMinus" Content="－" Classes="mini" Width="24"
                                ToolTip.Tip="缩小 10%（下限 20%）"/>
                        <TextBlock Grid.Column="2" x:Name="ScaleValueText" Text="100%" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" x:Name="BtnScalePlus" Content="＋" Classes="mini" Width="24"
                                ToolTip.Tip="放大 10%（上限 300%）"/>
                        <Button Grid.Column="4" x:Name="BtnScaleReset" Content="重置" Classes="mini"
                                ToolTip.Tip="比例恢复到 100%"/>
                      </Grid>

                      <Grid ColumnDefinitions="36,Auto,*,Auto,Auto" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="角度" Classes="lbl"/>
                        <Button Grid.Column="1" x:Name="BtnRotateLeft" Content="↺" Classes="mini" Width="24"
                                ToolTip.Tip="逆时针旋转 15°"/>
                        <TextBlock Grid.Column="2" x:Name="AngleValueText" Text="0°" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" x:Name="BtnRotateRight" Content="↻" Classes="mini" Width="24"
                                ToolTip.Tip="顺时针旋转 15°"/>
                        <Button Grid.Column="4" x:Name="BtnRotateReset" Content="重置" Classes="mini"
                                ToolTip.Tip="角度恢复到 0°"/>
                      </Grid>
                    </StackPanel>

                      </StackPanel>
                    </ScrollViewer>

                    <controls:ClassicScrollBar Grid.Column="1" Target="{Binding #TrafficScroll}"/>
                  </Grid>
                </Border>
              </Grid>

              <!-- 脚部只留「删除」：发布是整图动作，入口统一收在顶部工具条，避免选中物件时误点重复发布 -->
              <Grid Grid.Row="2" ColumnDefinitions="*,76" ColumnSpacing="8" Margin="0,8,0,0">
                <TextBlock Grid.Column="0" x:Name="PropHint" Text="" Classes="tip" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" x:Name="BtnDeleteObject" Content="删除" Height="26" Width="76" HorizontalAlignment="Right" HorizontalContentAlignment="Center" FontSize="12" Background="Transparent" Foreground="{StaticResource Theme.DangerDark}" BorderBrush="#E0B4B1" BorderThickness="1"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- 物品元件编辑：面板由 ItemElementPanel 在代码中挂载 -->
      <Border Grid.Row="1" x:Name="ItemPanelHost" IsVisible="False" Background="{StaticResource Theme.Window}"/>

      <!-- 迷雾编辑：面板由 FogEditPanel 在代码中挂载 -->
      <Border Grid.Row="1" x:Name="FogPanelHost" IsVisible="False" Background="{StaticResource Theme.Window}"/>

      <!-- 资源整理：面板由 ResourceOrganizePanel 在代码中挂载 -->
      <Border Grid.Row="1" x:Name="ResourcePanelHost" IsVisible="False" Background="{StaticResource Theme.Window}"/>

      <!-- 剧情编辑：面板由 StoryEditorPanel 在代码中挂载 -->
      <Border Grid.Row="1" x:Name="StoryPanelHost" IsVisible="False" Background="{StaticResource Theme.Window}"/>
    </Grid>
  </Grid>
</Window>
