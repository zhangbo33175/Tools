<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MapEditorTool.App"
             RequestedThemeVariant="Light">
            <!-- 冷蓝色板：浅蓝面板 + 白色输入区 + 深青蓝强调，统一走 Light 主题 -->

    <Application.Resources>
        <!-- 统一配色：低饱和墨青 + 冷白面板，只有一处强调青蓝；所有控件只引用语义资源，不写裸色值。 -->
        <SolidColorBrush x:Key="Theme.Window" Color="#E8F4F8" />
        <SolidColorBrush x:Key="Theme.Panel" Color="#F0F8FB" />
        <SolidColorBrush x:Key="Theme.PanelAlt" Color="#F6FBFD" />
        <SolidColorBrush x:Key="Theme.Card" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Theme.Border" Color="#C5DDE8" />
        <SolidColorBrush x:Key="Theme.BorderStrong" Color="#9FC6D6" />
        <SolidColorBrush x:Key="Theme.Divider" Color="#D8E9F0" />
        <SolidColorBrush x:Key="Theme.Text" Color="#17323D" />
        <SolidColorBrush x:Key="Theme.TextMuted" Color="#577380" />
        <SolidColorBrush x:Key="Theme.Primary" Color="#0D8CB6" />
        <SolidColorBrush x:Key="Theme.PrimaryDark" Color="#075E7C" />
        <SolidColorBrush x:Key="Theme.PrimarySoft" Color="#DDF2F9" />
        <SolidColorBrush x:Key="Theme.PrimaryHover" Color="#D3EFF8" />
        <SolidColorBrush x:Key="Theme.PrimaryPressed" Color="#B9E3F1" />
        <SolidColorBrush x:Key="Theme.ButtonSurface" Color="#E7F3F8" />
        <SolidColorBrush x:Key="Theme.ButtonBorder" Color="#B4D3E0" />
        <SolidColorBrush x:Key="Theme.Disabled" Color="#EDF5F8" />
        <SolidColorBrush x:Key="Theme.DisabledText" Color="#91A9B4" />
        <SolidColorBrush x:Key="Theme.Danger" Color="#C0504D" />
        <SolidColorBrush x:Key="Theme.DangerDark" Color="#A8463F" />
        <SolidColorBrush x:Key="Theme.DangerBorder" Color="#E6C9C7" />
        <SolidColorBrush x:Key="Theme.OverlaySurface" Color="#F4FAFD" />
        <SolidColorBrush x:Key="Theme.OverlayTitle" Color="#E4F4FB" />
        <SolidColorBrush x:Key="Theme.StatusLabel" Color="#9FC0D0" />
        <SolidColorBrush x:Key="Theme.StatusValue" Color="#EAF8FE" />
        <SolidColorBrush x:Key="Theme.StatusHint" Color="#AECBDA" />
        <SolidColorBrush x:Key="Theme.Teal" Color="#1E9E86" />
        <SolidColorBrush x:Key="Theme.TealDark" Color="#147A69" />
        <SolidColorBrush x:Key="Theme.Cyan" Color="#42B8D2" />
        <SolidColorBrush x:Key="Theme.Status" Color="#005E8D" />
        <SolidColorBrush x:Key="Theme.StatusBorder" Color="#004A70" />
        <SolidColorBrush x:Key="Theme.ScrollSurface" Color="#E7F3F8" />
        <SolidColorBrush x:Key="Theme.ScrollTrack" Color="#F5FBFD" />
        <SolidColorBrush x:Key="Theme.ScrollButton" Color="#E3F1F6" />
        <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#8FC9DC" />
        <SolidColorBrush x:Key="Theme.ScrollThumbBorder" Color="#5FA6BF" />
        <SolidColorBrush x:Key="Theme.ScrollArrow" Color="#355663" />
        <SolidColorBrush x:Key="Theme.Selection" Color="#330D8CB6" />

        <!-- 窗口与浮层：投影、标题栏交通灯、图层标识条 -->
        <SolidColorBrush x:Key="Theme.WindowDotClose" Color="#F1736F" />
        <SolidColorBrush x:Key="Theme.WindowDotMinimize" Color="#F3C75F" />
        <SolidColorBrush x:Key="Theme.WindowDotMaximize" Color="#56C88A" />
        <SolidColorBrush x:Key="Theme.LayerTagDot" Color="#E8A23F" />
        <BoxShadows x:Key="Theme.FloatingShadow">0 8 24 0 #55000000</BoxShadows>
        <BoxShadows x:Key="Theme.DialogShadow">0 14 36 0 #66000000</BoxShadows>

        <!-- 滑块沿用同一套冷蓝：Fluent 默认轨道是暖灰，放在青蓝界面里显得脏 -->
        <SolidColorBrush x:Key="SliderTrackFill" Color="#D8E9F0" />
        <SolidColorBrush x:Key="SliderTrackValueFill" Color="#0D8CB6" />
        <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#075E7C" />
        <SolidColorBrush x:Key="SliderThumbBackground" Color="#0D8CB6" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#075E7C" />
        <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#075E7C" />
        <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="#0D8CB6" />

        <!-- 统一复选框：16px 圆角小方块 + 白色对勾，替掉 Fluent 默认的方头方脑（浅灰描边 + 黑勾） -->
        <ControlTheme x:Key="FlatCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Theme.Text}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent">
                        <Panel Width="16" Height="16" VerticalAlignment="Center">
                            <Border Name="CheckBoxBox"
                                    CornerRadius="4"
                                    Background="{StaticResource Theme.Card}"
                                    BorderBrush="{StaticResource Theme.ButtonBorder}"
                                    BorderThickness="1" />
                            <Path Name="CheckBoxGlyph"
                                  Data="M 3,7.6 L 6.6,11.2 L 13,4"
                                  Stroke="{StaticResource Theme.Card}"
                                  StrokeThickness="1.7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Opacity="0" />
                        </Panel>
                        <ContentPresenter Grid.Column="1"
                                          Margin="7,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- 卡片标题条：极浅的冷白渐变（靠 1px 收口线分层），不再用高饱和冰青 -->
        <LinearGradientBrush x:Key="Theme.TitleBackground" StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#EEF8FC" Offset="0" />
            <GradientStop Color="#DDF0F8" Offset="0.55" />
            <GradientStop Color="#D2EBF6" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Theme.TitleBorder" Color="#AAD3E1" />
        <SolidColorBrush x:Key="Theme.TitleText" Color="#0B4256" />
        <SolidColorBrush x:Key="Theme.TitleGlyph" Color="#0B4256" />
        <SolidColorBrush x:Key="Theme.TitleGlyphHot" Color="#042530" />
        <SolidColorBrush x:Key="Theme.TitleChip" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Theme.TitleHover" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Theme.TitlePressed" Color="#55000000" />

        <!-- 卡片投影：1px 冷灰底影 + 6px 柔散，浅到不抢注意力，只负责把卡片从底色上托起来 -->
        <BoxShadows x:Key="Theme.CardShadow">0 1 2 0 #120E2A36, 0 4 12 0 #0A0E2A36</BoxShadows>

        <!-- 经典竖向滚动条：14px 宽，上下箭头常显，中间蓝灰滑块 -->
        <ControlTheme x:Key="ClassicVScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="14" />
            <Setter Property="MinWidth" Value="14" />
            <Setter Property="Background" Value="{StaticResource Theme.ScrollSurface}" />
            <Setter Property="AllowAutoHide" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Theme.Border}" BorderThickness="1,0,0,0">
                        <Grid RowDefinitions="15,*,15">
                            <RepeatButton Grid.Row="0" x:Name="PART_LineUpButton" Padding="0" CornerRadius="0"
                                          Background="{StaticResource Theme.ScrollButton}" BorderBrush="{StaticResource Theme.Border}" BorderThickness="0,0,0,1">
                                <Path Data="M0,4 L4,0 L8,4 Z" Fill="{StaticResource Theme.ScrollArrow}" Width="8" Height="4"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </RepeatButton>
                            <!-- 必须把 Minimum/Maximum/Value/ViewportSize 绑到模板父级，否则 Track 拿到默认值，
                                 滑块位置与长度都会算错（表现为滑块贴在轨道底部或长度不随内容变化） -->
                            <Track Grid.Row="1" x:Name="PART_Track" Orientation="Vertical" Margin="2,2"
                                   IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.Thumb>
                                    <Thumb MinHeight="20" Background="{StaticResource Theme.ScrollThumb}" BorderBrush="{StaticResource Theme.ScrollThumbBorder}" BorderThickness="1" CornerRadius="2">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <RepeatButton Grid.Row="2" x:Name="PART_LineDownButton" Padding="0" CornerRadius="0"
                                          Background="{StaticResource Theme.ScrollButton}" BorderBrush="{StaticResource Theme.Border}" BorderThickness="0,1,0,0">
                                <Path Data="M0,0 L8,0 L4,4 Z" Fill="{StaticResource Theme.ScrollArrow}" Width="8" Height="4"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </RepeatButton>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- 经典横向滚动条：14px 高，左右箭头常显 -->
        <ControlTheme x:Key="ClassicHScrollBar" TargetType="ScrollBar">
            <Setter Property="Height" Value="14" />
            <Setter Property="MinHeight" Value="14" />
            <Setter Property="Background" Value="{StaticResource Theme.ScrollSurface}" />
            <Setter Property="AllowAutoHide" Value="False" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Theme.Border}" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="15,*,15">
                            <RepeatButton Grid.Column="0" x:Name="PART_LineUpButton" Padding="0" CornerRadius="0"
                                          Background="{StaticResource Theme.ScrollButton}" BorderBrush="{StaticResource Theme.Border}" BorderThickness="0,0,1,0">
                                <Path Data="M4,0 L0,4 L4,8 Z" Fill="{StaticResource Theme.ScrollArrow}" Width="4" Height="8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </RepeatButton>
                            <Track Grid.Column="1" x:Name="PART_Track" Orientation="Horizontal" Margin="2,2"
                                   IsDirectionReversed="False"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}">
                                <Track.Thumb>
                                    <Thumb MinWidth="20" Background="{StaticResource Theme.ScrollThumb}" BorderBrush="{StaticResource Theme.ScrollThumbBorder}" BorderThickness="1" CornerRadius="2">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                            <RepeatButton Grid.Column="2" x:Name="PART_LineDownButton" Padding="0" CornerRadius="0"
                                          Background="{StaticResource Theme.ScrollButton}" BorderBrush="{StaticResource Theme.Border}" BorderThickness="0,0,0,0">
                                <Path Data="M0,0 L4,4 L0,8 Z" Fill="{StaticResource Theme.ScrollArrow}" Width="4" Height="8"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </RepeatButton>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- 按钮：冷白蓝底 + 1px 蓝灰边 + 深蓝文字，悬停变浅蓝，按下加深 -->
        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource Theme.ButtonSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.ButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Text}" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <!-- 顶部主界面导航：胶囊页签，未选中只留文字，选中铺浅青 + 青描边 + 加粗 -->
        <Style Selector="Button.navTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource Theme.TextMuted}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.navTab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Primary}" />
        </Style>

        <!-- 工具条上的浮窗开关（交通规则）：未开=浅青幽灵按钮，打开=实心青，状态一眼可辨 -->
        <Style Selector="Button.toolToggle">
            <Setter Property="Background" Value="{StaticResource Theme.PrimarySoft}" />
            <Setter Property="Foreground" Value="{StaticResource Theme.PrimaryDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.ButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <!-- 表格行内的扁平文字按钮：常态只有彩色文字，悬停才浮出浅底 -->
        <Style Selector="Button.rowAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.rowAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimarySoft}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.rowAction:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryPressed}" />
        </Style>
        <!-- 所有按钮文字统一水平 / 垂直居中，避免宽按钮内文字贴左 -->
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryHover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Primary}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryPressed}" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.Disabled}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Divider}" />
            <Setter Property="Foreground" Value="{StaticResource Theme.DisabledText}" />
        </Style>

        <!-- 按钮只有一个主操作：实心青底白字。其余动作一律走默认的白底细边，权重由颜色而不是尺寸区分 -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource Theme.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.PrimaryDark}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.PrimaryDark}" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.PrimaryDark}" />
        </Style>

        <!-- 危险动作：白底红字，悬停才浮出浅红底；不做实心红，避免和主操作抢视觉 -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.DangerBorder}" />
            <Setter Property="Foreground" Value="{StaticResource Theme.DangerDark}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14B85C58" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Danger}" />
        </Style>
        <Style Selector="Button.danger:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#26B85C58" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Danger}" />
        </Style>

        <!-- 幽灵动作：无底无边，只有文字与悬停蒙层，用于工具条里最次要的入口 -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Theme.TextMuted}" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Theme.PrimaryDark}" />
        </Style>

        <!-- 带下拉的按钮：展开期间铺一层主色浅底 + 主色描边，明确「这个菜单是开着的」 -->
        <Style Selector="Button:flyout-open /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimarySoft}" />
        </Style>
        <Style Selector="Button:flyout-open">
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Primary}" />
            <Setter Property="Foreground" Value="{StaticResource Theme.PrimaryDark}" />
        </Style>

        <!-- 下拉菜单行：白卡内的一行一动，左字右箭头，悬停整行浅浅抬起（对齐 Unity 菜单的观感） -->        <Style Selector="Button.menuRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Text}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.menuRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryHover}" />
        </Style>
        <Style Selector="Button.menuRow:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryPressed}" />
        </Style>
        <!-- 破坏性动作：常态红字，悬停给一层淡红，避免和普通行混为一谈 -->
        <Style Selector="Button.menuRow.dangerRow">
            <Setter Property="Foreground" Value="{StaticResource Theme.Danger}" />
        </Style>
        <Style Selector="Button.menuRow.dangerRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#14C0524E" />
        </Style>

        <!-- 菜单分组分隔线：不顶满边，两侧留白，读起来是「组」而不是「表格线」 -->
        <Style Selector="Border.menuDivider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{StaticResource Theme.Divider}" />
        </Style>

        <!-- 步进器箭头：贴合输入框的上下三角按钮，常态透明、悬停浅青、按下加深 -->
        <Style Selector="Button.spin">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Height" Value="12" />
            <Setter Property="MinHeight" Value="12" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Theme.PrimaryDark}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.spin:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimarySoft}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.spin:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryPressed}" />
        </Style>

        <!-- 自绘标题栏的系统按钮：透明贴边，悬停用白色叠光，关闭按钮单独转红。
             标题栏是浅青底，字形必须走深墨（Theme.TitleGlyph），否则和底同色看不见 -->
        <Style Selector="Button.caption">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource Theme.TitleGlyph}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.caption:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Theme.TitleGlyphHot}" />
        </Style>
        <!-- 字形是矢量 Path（不再吃 Foreground），悬停要单独提亮到纯白 -->
        <Style Selector="Button.caption:pointerover Path">
            <Setter Property="Stroke" Value="{StaticResource Theme.TitleGlyphHot}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover Path">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A0A2E3A" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#290A2E3A" />
        </Style>
        <Style Selector="Button.caption.dark">
            <Setter Property="Foreground" Value="{StaticResource Theme.TitleGlyph}" />
        </Style>
        <Style Selector="Button.caption.dark:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#140A2E3A" />
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.Danger}" />
        </Style>
        <Style Selector="Button.caption.close:pointerover">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.caption.close:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.DangerDark}" />
        </Style>

        <!-- 左侧资源类型：分段式 Tab，未选中透明、选中蓝底白字，避免五个按钮各带一圈灰边 -->
        <Style Selector="Button.sideTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Theme.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sideTab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimarySoft}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Theme.PrimaryDark}" />
        </Style>
        <Style Selector="Button.sideTab.active">
            <Setter Property="Background" Value="{StaticResource Theme.Primary}" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Card}" />
        </Style>
        <Style Selector="Button.sideTab.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryDark}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Card}" />
        </Style>

        <!-- 输入框：内凹一档的青白底 + 蓝灰边 + 圆角 6（与卡片 8 / 按钮 5 成一套），
             白卡上靠这点底色差读出「这里可以填」 -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource Theme.ButtonSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.ButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Text}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Primary}" />
        </Style>
        <!-- 表格内单元格编辑器：常态与悬停都保持透明底，让整行高亮带完整透出来；
             只有获得焦点时才浮出白底 + 强调描边，明确「这一格可以改」 -->
        <Style Selector="TextBox.cell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="TextBox.cell /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.cell:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Theme.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Primary}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- 未选中对象时属性区会整片禁用：Fluent 默认铺灰，换成浅青白底，看着像「待填写」而不是「坏掉」 -->
        <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource Theme.PanelAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Divider}" />
        </Style>
        <Style Selector="TextBox:disabled">
            <Setter Property="Foreground" Value="{StaticResource Theme.TextMuted}" />
        </Style>
        <Style Selector="ComboBox:disabled /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource Theme.PanelAlt}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Divider}" />
        </Style>
        <!-- Fluent 文本框的文字 presenter 默认贴模板上沿，数字 / 中文墨迹会比 24px 框中心高约 2px；统一下移 2px 回到视觉中线。 -->
        <Style Selector="TextBox.field /template/ TextPresenter">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- 下拉框：与文本框同一档内凹底色 + 蓝灰边，白卡上才有「可填」的层次 -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource Theme.ButtonSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.ButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Text}" />
        </Style>
        <!-- Fluent 模板里的选中内容默认贴顶，把模板内 ContentPresenter 压回垂直居中；
             可编辑下拉框内部的 TextBox 也要单独居中，否则「动画名称」这类值会浮在框顶。 -->
        <Style Selector="ComboBox /template/ ContentPresenter">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="24" />
        </Style>

        <!-- 复选框：被勾选时用强调蓝；文字与勾选框同高居中，避免文字贴行顶 -->
        <Style Selector="CheckBox">
            <Setter Property="Theme" Value="{StaticResource FlatCheckBox}" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Text}" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="CheckBox /template/ Border#CheckBoxBox">
            <Setter Property="Background" Value="{StaticResource Theme.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.ButtonBorder}" />
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#CheckBoxBox">
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Primary}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#CheckBoxBox">
            <Setter Property="Background" Value="{StaticResource Theme.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Primary}" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckBoxGlyph">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="CheckBox:checked:pointerover /template/ Border#CheckBoxBox">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.PrimaryDark}" />
        </Style>
        <Style Selector="CheckBox:disabled /template/ Border#CheckBoxBox">
            <Setter Property="Background" Value="{StaticResource Theme.Disabled}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.DisabledText}" />
        </Style>

        <!-- 三栏分隔条：平时透明只露 1px 灰线，悬停整条 6px 变淡蓝提示可拖。
             GridSplitter 默认没有可视模板，这里补一个纯背景 Border，Background 才能随 :pointerover 换色。 -->
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="#00000000" />
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{StaticResource Theme.Selection}" />
        </Style>

        <!-- 卡片：底部三栏统一的白底 + 1px 蓝灰边 + 圆角 8 + 极浅投影 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource Theme.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="{StaticResource Theme.CardShadow}" />
        </Style>

        <!-- 外层分区框：比卡片重一级的描边，用来把「左侧栏 / 工具条 / 画布」这些大区块框出来；圆角与卡片统一 8 -->
        <Style Selector="Border.frame">
            <Setter Property="Background" Value="{StaticResource Theme.Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- 卡片内白色分组框 -->
        <Style Selector="Border.inset">
            <Setter Property="Background" Value="{StaticResource Theme.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <!-- 表单标签：右对齐、统一灰色、垂直居中（不再额外上提，和文本框内容共用同一条视觉中线）。 -->
        <Style Selector="TextBlock.lbl">
            <Setter Property="Foreground" Value="{StaticResource Theme.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- 卡片标题条：极浅冷白打底，底边 1px 收口；标题文字深墨青，左侧再配 3px 强调竖条（见各卡片标题行） -->
        <Style Selector="Border.titleBar">
            <Setter Property="Background" Value="{StaticResource Theme.TitleBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.TitleBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="Foreground" Value="{StaticResource Theme.TitleText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 标题条上的文字按钮：默认透明融入底色，悬停 / 按下时才浮出白色 / 黑色蒙层 -->
        <Style Selector="Button.titleAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Theme.TitleText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="Button.titleAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.TitleHover}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.titleAction:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.TitlePressed}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <!-- 区块标题 -->
        <Style Selector="TextBlock.section">
            <Setter Property="Background" Value="{StaticResource Theme.TitleChip}" />
            <Setter Property="Foreground" Value="{StaticResource Theme.PrimaryDark}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,1" />
        </Style>

        <!-- 小号提示文字 -->
        <Style Selector="TextBlock.tip">
            <Setter Property="Foreground" Value="{StaticResource Theme.TextMuted}" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- 表单输入框：统一高度 -->
        <Style Selector="TextBox.field">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- 表单下拉框：统一高度 -->
        <Style Selector="ComboBox.field">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 小按钮：卡片内统一 24px 高 -->
        <Style Selector="Button.mini">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,1" />
        </Style>

        <!-- 分段页签按钮：默认透明，选中态由 ApplyTabVisual 铺白底胶囊（路径 / 动画页签用） -->
        <Style Selector="Button.segTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Theme.TextMuted}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- 交通标记按钮：白底细边 + 圆角 5；已标记时整颗变浅青底、主色描边，未选中物件时置灰 -->
        <Style Selector="Button.markTool">
            <Setter Property="Background" Value="{StaticResource Theme.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.ButtonBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{StaticResource Theme.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.markTool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.ButtonSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Primary}" />
        </Style>
        <Style Selector="Button.markTool:pointerover">
            <Setter Property="Foreground" Value="{StaticResource Theme.PrimaryDark}" />
        </Style>
        <Style Selector="Button.markTool:disabled">
            <Setter Property="Foreground" Value="{StaticResource Theme.DisabledText}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.markTool:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.Disabled}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Divider}" />
        </Style>
        <Style Selector="Button.markTool.marked">
            <Setter Property="Background" Value="{StaticResource Theme.PrimarySoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Primary}" />
            <Setter Property="Foreground" Value="{StaticResource Theme.PrimaryDark}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.markTool.marked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryPressed}" />
        </Style>

        <!-- 滑动列表：常显的经典滚动条（14px 宽 + 上下箭头） -->
        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False"/>
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="Theme" Value="{StaticResource ClassicVScrollBar}"/>
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="Theme" Value="{StaticResource ClassicHScrollBar}"/>
        </Style>

        <!-- 「楼层参考」默认就是勾选态：该开关在模板套用前就带了 IsChecked=True，
             通用 :checked 的底色不会刷到这个模板子件上（表现为勾了却没填充），
             这里按 ID 落一条同色覆盖，保证默认勾选一眼可见。 -->
        <Style Selector="CheckBox#ShowOtherLevelsToggle:checked /template/ Border#CheckBoxBox">
            <Setter Property="Background" Value="{StaticResource Theme.Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.Primary}" />
        </Style>
        <Style Selector="CheckBox#ShowOtherLevelsToggle:checked:pointerover /template/ Border#CheckBoxBox">
            <Setter Property="Background" Value="{StaticResource Theme.PrimaryDark}" />
            <Setter Property="BorderBrush" Value="{StaticResource Theme.PrimaryDark}" />
        </Style>
        <Style Selector="CheckBox#ShowOtherLevelsToggle:checked /template/ Path#CheckBoxGlyph">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </Application.Styles>
</Application>
