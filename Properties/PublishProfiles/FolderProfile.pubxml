<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>dist\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- 编辑器按 exe 同目录找 MapData / docs / output，发布后必须一起带上。 -->
  <Target Name="CopyEditorRuntimeData" AfterTargets="Publish">
    <ItemGroup>
      <EditorMapData Include="$(MSBuildProjectDirectory)\MapData\**\*" />
      <EditorDocs Include="$(MSBuildProjectDirectory)\docs\**\*" />
      <EditorSeedConfig Include="$(MSBuildProjectDirectory)\bin\Debug\net10.0\output\Config\**\*" />
      <EditorPublishPdb Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>

    <Copy SourceFiles="@(EditorMapData)"
          DestinationFiles="@(EditorMapData->'$(PublishDir)MapData\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EditorDocs)"
          DestinationFiles="@(EditorDocs->'$(PublishDir)docs\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EditorSeedConfig)"
          DestinationFiles="@(EditorSeedConfig->'$(PublishDir)output\Config\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <!-- 这两份保留：本机/同工程路径下可直接用；换机器时需在编辑器里重设资源根与表格路径。 -->
    <Delete Files="@(EditorPublishPdb)" />
  </Target>
</Project>
